{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小米手表 AI 指令助手",
  "version": "1.1.1",
  "identifier": "com.young.agentcommandpilot",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "小米手表 AI 指令助手",
        "width": 1040,
        "height": 750,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBRUFCNTZBMjVENjZFRDYKUldUV2J0WWxhclhxZXFQcEZWS0dxL0NrQmt0ZFpsSWtlVWpUS3VhWVZjZk1DUDZNU3YrbVFrTnEK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
