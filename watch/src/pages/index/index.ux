<template>
  <div class="container">
    <!-- 视图 1：主界面 -->
    <div if="{{viewMode === 'main'}}" class="page-view">
      <div class="header">
        <div class="header-left">
          <text class="eyebrow">WRIST COMMAND</text>
          <text class="title">指令助手</text>
          <div class="status-row">
            <div class="status-dot {{connected ? 'dot-online' : 'dot-offline'}}"></div>
            <text class="status-text">{{statusText}}</text>
          </div>
        </div>
        <div class="btn-settings-header" onclick="goToSettings">
          <text class="settings-btn-text">设置  ›</text>
        </div>
      </div>

      <div if="{{hasCommands}}" class="queue-heading">
        <text class="queue-title">待处理</text>
        <text class="queue-count">{{commandsCount}} 项</text>
      </div>

      <!-- 多指令卡片滚动列表 -->
      <list if="{{hasCommands}}" class="cmd-list">
        <list-item type="cmd" class="cmd-item" for="(cIdx, item) in commandsList">
          <div class="command-card">
            <div class="card-top">
              <div class="card-top-left">
                <text class="card-badge">{{item.is_question ? '需要选择' : '需要确认'}}</text>
                <text if="{{item.is_question || (item.actions && item.actions.length > 2 && !item.is_approval)}}" class="card-type-badge {{item.is_multiselect ? 'badge-multi' : 'badge-single'}}">{{item.is_multiselect ? '多选' : '单选'}}</text>
              </div>
              <text class="card-source">{{item.source || 'Codex'}}</text>
            </div>
            <text class="card-title">{{item.title || '新指令'}}</text>
            <text if="{{item.content}}" class="card-content">{{item.content}}</text>

            <!-- 场景 1: 提问/选择类卡片 (模式由 Codex 端的 is_multi_select 决定) -->
            <div if="{{item.is_question || (item.actions && item.actions.length > 2 && !item.is_approval)}}" class="question-container">
              <!-- 选项列表 (单选时为互斥高亮，多选时为多重勾选) -->
              <div class="options-list">
                <div
                  for="(aIdx, action) in item.choice_actions"
                  class="option-pill {{action.selected ? 'option-pill-selected' : 'option-pill-normal'}}"
                  onclick="toggleOption(cIdx, aIdx)"
                >
                  <div class="option-check-circle {{action.selected ? 'circle-selected' : 'circle-normal'}}">
                    <text class="circle-check-icon">{{action.selected ? '✓' : ''}}</text>
                  </div>
                  <text class="option-pill-text {{action.selected ? 'text-selected' : ''}}">{{action.text}}</text>
                </div>
              </div>

              <text if="{{item.choice_actions.length === 0}}" class="question-hint">此题需要在电脑上输入回答</text>

              <!-- 确认提交所选按钮 -->
              <div if="{{item.selected_count > 0}}" class="btn-submit-selection" onclick="submitSelection(cIdx)">
                <text if="{{item.is_multiselect}}" class="btn-submit-text">确认提交 (已选{{item.selected_count}}项)</text>
                <text else class="btn-submit-text">确认选择: {{item.selected_text}}</text>
              </div>

              <!-- 回退到电脑输入按钮 -->
              <div class="btn-pc-fallback" onclick="handleReply(item.id, 'pc_input')">
                <text class="btn-pc-text">在电脑键盘输入</text>
              </div>
            </div>

            <!-- 场景 2: 审批按键；三项操作纵排，避免在手表上挤压触控区域 -->
            <div else class="actions-row {{item.is_approval ? 'approval-actions' : ''}}">
              <div for="(aIdx, action) in item.actions" class="action-wrapper {{item.is_approval ? 'approval-action-wrapper' : ''}}">
                <div
                  class="btn-action btn-{{action.style || 'default'}}"
                  onclick="handleReply(item.id, action.id)"
                >
                  <text class="btn-action-text {{action.style === 'primary' ? 'action-primary-text' : ''}}">{{action.text}}</text>
                </div>
              </div>
            </div>

          </div>
        </list-item>
      </list>

      <!-- 暂无指令展示 -->
      <div else class="empty-container">
        <div class="empty-badge {{!watchToken ? 'empty-unpaired' : (connected ? 'empty-ready' : 'empty-disconnected')}}">
          <text class="empty-badge-text">{{connected ? '✓' : '·'}}</text>
        </div>
        <text class="empty-title">{{!watchToken ? '尚未配对' : (connected ? '一切就绪' : '等待连接')}}</text>
        <text class="empty-desc">{{connected ? '新的请求会出现在这里' : logMsg}}</text>
        <div if="{{watchToken}}" class="sync-pill">
          <div class="sync-dot"></div>
          <text class="sync-tag">{{connected ? '监听中' : statusText}} · {{pollIntervalSec}} 秒同步</text>
        </div>
        <div if="{{!watchToken}}" class="btn-empty-settings btn-home-pair" onclick="goToPairing">
          <text class="empty-settings-text home-pair-text">配对手表  ›</text>
        </div>
        <div if="{{!connected && watchToken}}" class="btn-empty-settings btn-home-discover" onclick="goToDiscovery">
          <text class="empty-settings-text">查找电脑  ›</text>
        </div>
      </div>
    </div>

    <!-- 视图 2：设置中心界面 -->
    <div if="{{viewMode === 'settings'}}" class="page-view">
      <list class="settings-list">
        <!-- 导航返回栏 -->
        <list-item type="nav" class="settings-nav-item">
          <div class="settings-nav">
            <div class="btn-back" onclick="goToMain">
              <text class="btn-back-text">返回</text>
            </div>
            <text class="nav-title">设置</text>
            <div class="nav-placeholder"></div>
          </div>
        </list-item>

        <!-- 卡片 1: 屏幕常亮 -->
        <list-item type="awake" class="setting-card-item">
          <div class="setting-card">
            <div class="setting-row">
              <div class="setting-label-col">
                <text class="setting-label">屏幕常亮</text>
                <text class="setting-sub">应用打开时保持亮屏</text>
              </div>
              <div class="setting-toggle {{keepScreenOn ? 'toggle-on' : 'toggle-off'}}" onclick="toggleKeepAwake">
                <text class="toggle-text {{keepScreenOn ? 'toggle-text-on' : ''}}">{{keepScreenOn ? '已开启' : '已关闭'}}</text>
              </div>
            </div>
          </div>
        </list-item>

        <!-- 卡片 2: 轮询频率 (轮巡时间) -->
        <list-item type="interval" class="setting-card-item">
          <div class="setting-card">
            <text class="setting-label">同步间隔</text>
            <text class="setting-sub">当前 {{pollIntervalSec}} 秒 · 时间越长越省电</text>
            <div class="interval-options">
              <div class="interval-pill {{pollIntervalSec === 1 ? 'pill-active' : 'pill-inactive'}}" onclick="setPollInterval(1)">
                <text class="pill-text {{pollIntervalSec === 1 ? 'pill-text-active' : ''}}">1秒</text>
              </div>
              <div class="interval-pill {{pollIntervalSec === 2 ? 'pill-active' : 'pill-inactive'}}" onclick="setPollInterval(2)">
                <text class="pill-text {{pollIntervalSec === 2 ? 'pill-text-active' : ''}}">2秒</text>
              </div>
              <div class="interval-pill {{pollIntervalSec === 3 ? 'pill-active' : 'pill-inactive'}}" onclick="setPollInterval(3)">
                <text class="pill-text {{pollIntervalSec === 3 ? 'pill-text-active' : ''}}">3秒</text>
              </div>
              <div class="interval-pill {{pollIntervalSec === 5 ? 'pill-active' : 'pill-inactive'}}" onclick="setPollInterval(5)">
                <text class="pill-text {{pollIntervalSec === 5 ? 'pill-text-active' : ''}}">5秒</text>
              </div>
            </div>
          </div>
        </list-item>

        <!-- 卡片 3: 自定义服务器地址入口 -->
        <list-item type="server" class="setting-card-item">
          <div class="setting-card" onclick="goToServerEdit">
            <div class="server-card-top">
              <text class="setting-label">电脑地址</text>
              <text class="server-edit-badge">修改  ›</text>
            </div>
            <text class="server-current-url">{{currentServerUrl}}</text>
            <text class="setting-sub">与电脑在同一局域网时使用</text>
          </div>
        </list-item>

        <list-item type="discover" class="setting-card-item">
          <div class="setting-card" onclick="goToDiscovery">
            <text class="setting-label">查找电脑  ›</text>
            <text class="setting-sub">地址变化时搜索可连接的服务</text>
          </div>
        </list-item>

        <list-item type="restore" class="setting-card-item">
          <div class="setting-card" onclick="restoreDefaultServer">
            <text class="setting-label">恢复安装包地址  ›</text>
            <text class="setting-sub">{{defaultServerUrl}}</text>
          </div>
        </list-item>

        <list-item type="pairing" class="setting-card-item">
          <div class="setting-card" onclick="goToPairing">
            <text class="setting-label">手表配对</text>
            <text class="setting-sub">{{pairingStatus}} · 输入电脑显示的六位码</text>
          </div>
        </list-item>

        <!-- 卡片 4: 快速工具 -->
        <list-item type="tools" class="setting-card-item">
          <div class="setting-card">
            <text class="setting-label">硬件与连接测试</text>
            <div class="tools-row">
              <div class="btn-tool" onclick="testVibrate">
                <text class="btn-tool-text">测试振动</text>
              </div>
              <div class="btn-tool" onclick="manualRefresh">
                <text class="btn-tool-text">立即同步</text>
              </div>
            </div>
          </div>
        </list-item>

        <!-- 卡片 5: 系统信息 -->
        <list-item type="info" class="setting-card-item">
          <div class="setting-card info-card">
            <div class="info-row">
              <text class="info-key">当前版本</text>
              <text class="info-val info-val-highlight">v1.1.6</text>
            </div>
            <div class="info-row">
              <text class="info-key">唤醒通道</text>
              <text class="info-val">前台轮询 · ntfy 提醒</text>
            </div>
          </div>
        </list-item>

        <!-- 底部完成返回按钮 -->
        <list-item type="done" class="setting-foot-item">
          <div class="btn-done" onclick="goToMain">
            <text class="btn-done-text">返回首页</text>
          </div>
        </list-item>
      </list>
    </div>

    <!-- 视图 3：服务器地址独立键盘编辑器 -->
    <div if="{{viewMode === 'server_edit'}}" class="page-view">
      <list class="settings-list">
        <!-- 导航返回栏 -->
        <list-item type="nav" class="settings-nav-item">
          <div class="settings-nav">
            <div class="btn-back" onclick="goBackFromServerEdit">
              <text class="btn-back-text">返回设置</text>
            </div>
            <text class="nav-title">修改服务器</text>
            <div class="nav-placeholder"></div>
          </div>
        </list-item>

        <!-- 地址实时输入框 -->
        <list-item type="editor" class="setting-card-item">
          <div class="editor-box">
            <text class="editor-prefix">http://</text>
            <text class="editor-value">{{inputServerHost || '点击下方键盘输入'}}</text>
          </div>
        </list-item>

        <!-- 快捷操作胶囊 (192.168. / :8000 / 清空) -->
        <list-item type="presets" class="setting-card-item">
          <div class="presets-row">
            <div class="btn-preset" onclick="insertPreset('192.168.')">
              <text class="preset-text">192.168.</text>
            </div>
            <div class="btn-preset" onclick="insertPreset(':8000')">
              <text class="preset-text">:8000</text>
            </div>
            <div class="btn-preset btn-clear" onclick="clearInputHost">
              <text class="preset-text clear-text">清空</text>
            </div>
          </div>
        </list-item>

        <!-- 3x4 独立数字拨号键盘 (高对比度、大按键防误触) -->
        <list-item type="keypad" class="setting-card-item">
          <div class="keypad-container">
            <div class="keypad-row">
              <div class="key-btn" onclick="pressKey('1')"><text class="key-text">1</text></div>
              <div class="key-btn" onclick="pressKey('2')"><text class="key-text">2</text></div>
              <div class="key-btn" onclick="pressKey('3')"><text class="key-text">3</text></div>
            </div>
            <div class="keypad-row">
              <div class="key-btn" onclick="pressKey('4')"><text class="key-text">4</text></div>
              <div class="key-btn" onclick="pressKey('5')"><text class="key-text">5</text></div>
              <div class="key-btn" onclick="pressKey('6')"><text class="key-text">6</text></div>
            </div>
            <div class="keypad-row">
              <div class="key-btn" onclick="pressKey('7')"><text class="key-text">7</text></div>
              <div class="key-btn" onclick="pressKey('8')"><text class="key-text">8</text></div>
              <div class="key-btn" onclick="pressKey('9')"><text class="key-text">9</text></div>
            </div>
            <div class="keypad-row">
              <div class="key-btn" onclick="pressKey('.')"><text class="key-text">.</text></div>
              <div class="key-btn" onclick="pressKey('0')"><text class="key-text">0</text></div>
              <div class="key-btn key-btn-del" onclick="deleteLastChar()"><text class="key-text-del">删除</text></div>
            </div>
          </div>
        </list-item>

        <!-- 测试与保存动作栏 -->
        <list-item type="actions" class="setting-foot-item">
          <div class="editor-actions-row">
            <div class="btn-test-conn" onclick="testCustomConnection">
              <text class="test-conn-text">探测连通性</text>
            </div>
            <div class="btn-save-conn" onclick="saveCustomServer">
              <text class="save-conn-text">保存并生效</text>
            </div>
          </div>
        </list-item>
      </list>
    </div>

    <div if="{{viewMode === 'pairing'}}" class="pairing-page">
      <div class="pair-header">
        <div class="pair-back" onclick="goBackFromPairing"><text class="pair-back-text">‹  返回</text></div>
        <text class="pair-title">手表配对</text>
        <div class="pair-header-spacer"></div>
      </div>
      <div class="pair-server-row" onclick="goToDiscovery">
        <text class="pair-server-label">电脑地址</text>
        <text class="pair-server-value">{{currentServerUrl}}</text>
        <text class="pair-server-arrow">查找 ›</text>
      </div>
      <div class="pair-code-row">
        <div for="(slotIndex, digit) in pairingSlots" class="pair-code-slot {{digit === '·' ? 'pair-code-empty' : 'pair-code-filled'}}">
          <text class="pair-code-text">{{digit}}</text>
        </div>
      </div>
      <text class="pair-hint">{{pairingHint}}</text>
      <div class="pair-keypad">
        <div class="pair-key-row">
          <div class="pair-key" onclick="pressPairDigit('1')"><text class="pair-key-number">1</text></div>
          <div class="pair-key" onclick="pressPairDigit('2')"><text class="pair-key-number">2</text></div>
          <div class="pair-key" onclick="pressPairDigit('3')"><text class="pair-key-number">3</text></div>
        </div>
        <div class="pair-key-row">
          <div class="pair-key" onclick="pressPairDigit('4')"><text class="pair-key-number">4</text></div>
          <div class="pair-key" onclick="pressPairDigit('5')"><text class="pair-key-number">5</text></div>
          <div class="pair-key" onclick="pressPairDigit('6')"><text class="pair-key-number">6</text></div>
        </div>
        <div class="pair-key-row">
          <div class="pair-key" onclick="pressPairDigit('7')"><text class="pair-key-number">7</text></div>
          <div class="pair-key" onclick="pressPairDigit('8')"><text class="pair-key-number">8</text></div>
          <div class="pair-key" onclick="pressPairDigit('9')"><text class="pair-key-number">9</text></div>
        </div>
        <div class="pair-key-row pair-key-row-last">
          <div class="pair-key pair-key-utility" onclick="deletePairDigit"><text class="pair-key-label">删除</text></div>
          <div class="pair-key" onclick="pressPairDigit('0')"><text class="pair-key-number">0</text></div>
          <div class="pair-key pair-key-utility" onclick="clearPairingCode"><text class="pair-key-label">清空</text></div>
        </div>
      </div>
      <div class="pair-submit {{pairingCode.length === 6 ? 'pair-submit-ready' : 'pair-submit-idle'}}" onclick="submitPairing">
        <text class="pair-submit-text {{pairingCode.length === 6 ? 'pair-submit-text-ready' : ''}}">{{pairingBusy ? '正在配对…' : '确认配对'}}</text>
      </div>
    </div>

    <div if="{{viewMode === 'discovery'}}" class="discovery-page">
      <div class="pair-header">
        <div class="pair-back" onclick="goBackFromDiscovery"><text class="pair-back-text">‹  返回</text></div>
        <text class="pair-title">查找电脑</text>
        <div class="pair-header-spacer"></div>
      </div>
      <text class="discovery-intro">寻找运行指令助手的电脑</text>
      <text class="discovery-status">{{discoveryStatus}}</text>
      <div for="(serverIndex, server) in discoveredServers" class="discovery-result" onclick="selectDiscoveredServer(server.url)">
        <text class="discovery-result-name">{{server.name}}</text>
        <text class="discovery-result-url">{{server.url}}</text>
        <text class="discovery-result-action">使用此电脑  ›</text>
      </div>
      <div class="discovery-spacer"></div>
      <div class="discovery-refresh" onclick="startDiscovery">
        <text class="discovery-refresh-text">{{discoveryBusy ? '正在搜索…' : '重新搜索'}}</text>
      </div>
      <div class="discovery-manual" onclick="goToServerEdit">
        <text class="discovery-manual-text">手动输入电脑地址</text>
      </div>
    </div>
  </div>
</template>

<style>
  .container {
    width: 432px;
    height: 514px;
    flex-direction: column;
    background-color: #000000;
  }
  .page-view {
    width: 100%;
    height: 100%;
    flex-direction: column;
    padding: 26px 28px 12px 28px;
  }

  /* 顶部状态栏 - 宽安全边距避开曲面圆角 */
  .header {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
    margin-bottom: 8px;
  }
  .header-left {
    flex-direction: column;
    padding-left: 4px;
  }
  .title {
    color: #ffffff;
    font-size: 26px;
    font-weight: bold;
    letter-spacing: 1px;
  }
  .status-row {
    flex-direction: row;
    align-items: center;
    margin-top: 5px;
  }
  .status-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 6px;
  }
  .dot-online {
    background-color: #00e676;
  }
  .dot-offline {
    background-color: #ff5252;
  }
  .status-text {
    color: #888888;
    font-size: 17px;
  }
  .badge-count {
    color: #2979ff;
    font-size: 17px;
    margin-left: 6px;
    font-weight: bold;
  }

  /* 大触控区设置胶囊按钮 (宽 84px，高 48px) */
  .btn-settings-header {
    height: 48px;
    padding: 0 22px;
    background-color: #1e1e28;
    border-radius: 24px;
    border: 1px solid #3c3c52;
    justify-content: center;
    align-items: center;
  }
  .settings-btn-text {
    color: #00e676;
    font-size: 20px;
    font-weight: bold;
  }

  /* 指令卡片列表 */
  .cmd-list {
    width: 100%;
    flex: 1;
    flex-direction: column;
  }
  .cmd-item {
    width: 100%;
    margin-bottom: 12px;
  }
  .command-card {
    width: 100%;
    background-color: #141418;
    border-radius: 18px;
    padding: 14px 14px;
    flex-direction: column;
    border: 1px solid #2979ff;
  }
  .card-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }
  .card-top-left {
    flex-direction: row;
    align-items: center;
  }
  .card-badge {
    color: #2979ff;
    font-size: 18px;
    font-weight: bold;
  }
  .card-type-badge {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
    border-radius: 6px;
    padding: 2px 6px;
    margin-left: 6px;
  }
  .badge-single {
    background-color: #2979ff;
  }
  .badge-multi {
    background-color: #7c4dff;
  }
  .card-source {
    color: #00e676;
    background-color: #1a2e22;
    font-size: 16px;
    font-weight: bold;
    border-radius: 6px;
    padding: 2px 8px;
  }
  .card-title {
    color: #ffffff;
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 6px;
  }
  .card-content {
    color: #cccccc;
    font-size: 20px;
    line-height: 28px;
    margin-bottom: 12px;
  }

  /* 场景 1: 提问选择项容器与胶囊 */
  .question-container {
    width: 100%;
    flex-direction: column;
    margin-bottom: 6px;
  }
  .options-list {
    width: 100%;
    flex-direction: column;
  }
  .question-hint {
    color: #aaaaaa;
    font-size: 17px;
    margin-bottom: 8px;
  }
  .option-pill {
    width: 100%;
    height: 52px;
    border-radius: 26px;
    flex-direction: row;
    align-items: center;
    padding: 0 14px;
    margin-bottom: 8px;
  }
  .option-pill-normal {
    background-color: #1a1a24;
    border: 1px solid #323246;
  }
  .option-pill-selected {
    background-color: #0a301c;
    border: 2px solid #00e676;
  }
  .option-check-circle {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    justify-content: center;
    align-items: center;
    margin-right: 10px;
  }
  .circle-normal {
    border: 2px solid #555568;
  }
  .circle-selected {
    background-color: #00e676;
    border: 2px solid #00e676;
  }
  .circle-check-icon {
    color: #000000;
    font-size: 16px;
    font-weight: bold;
  }
  .option-pill-text {
    color: #cccccc;
    font-size: 19px;
    font-weight: bold;
    flex: 1;
  }
  .text-selected {
    color: #ffffff;
  }
  .btn-submit-selection {
    width: 100%;
    height: 52px;
    border-radius: 26px;
    background-color: #00c853;
    justify-content: center;
